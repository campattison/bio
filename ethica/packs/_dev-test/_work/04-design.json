      "id": "conceptual_analysis",
      "name": "Conceptual Analysis",
      "description": "Dissects the meaning of key notions — 'could have done otherwise', 'because', 'means' — to expose hidden structure in a principle.",
      "color_hex": "2980b9",
      "key_methods": [
        "definition parsing",
        "principle revision",
        "distinction drawing",
        "logical isolation"
      ]
    },
    {
      "id": "anti_physicalist_metaphysics",
      "name": "Anti-Physicalist Metaphysics",
      "description": "Argues that a complete physical account leaves a residue — qualia, rights, or responsibility — that resists reduction.",
      "color_hex": "8e44ad",
      "key_methods": [
        "knowledge argument",
        "modal comparison",
        "explanatory gap",
        "epistemic humility"
      ]
    },
    {
      "id": "rights_deontology",
      "name": "Rights Deontology",
      "description": "Holds that stringent rights trump aggregate utility, so better outcomes do not automatically license an act.",
      "color_hex": "27ae60",
      "key_methods": [
        "rights as trumps",
        "permissibility tests",
        "means vs redirection",
        "constraint analysis"
      ]
    }
